[configuration]
entry_symbol = "gdext_rust_init"
compatibility_minimum = 4.1
reloadable = true

[libraries]
linux.x86_64 =     "res://../target/debug/libechobard_ext.so"
windows.x86_64 =   "res://../target/debug/echobard_ext.dll"
macos =            "res://../target/debug/libechobard_ext.dylib"
macos.arm64 =      "res://../target/debug/libechobard_ext.dylib"
